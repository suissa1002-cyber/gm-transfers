@echo off
REM ── מפעיל עמיד לסוכן ההורדות (GreenOS → קופת NewOrder) ──────────────
REM  ⚠️ למה זה קיים: הסוכן רץ בחלון cmd ידני. סגירת החלון, ריסטארט או קריסה
REM  השאירו את סיטי בלי הורדות — ב-11-18/08/2026 זה נמשך 6.7 ימים בלי שאיש ידע.
REM  כאן: הרצה בלולאה (קריסה = עלייה מחדש אחרי 15 שניות) + מיועד להירשם
REM  כמשימה מתוזמנת שעולה עם ההתחברות, עם הרשאות מנהל.
REM  ⛔ חייב הרשאות מנהל: הקופה רצה מוגברת, ו-Windows חוסם תהליך לא-מוגבר
REM  מלשלוט על חלונותיה (Access is denied).
title GreenOS POS Agent
cd /d "%~dp0"
:loop
python agent.py
echo.
echo [%date% %time%] הסוכן נעצר. עולה מחדש בעוד 15 שניות... (Ctrl+C ליציאה)
timeout /t 15 /nobreak >nul
goto loop
